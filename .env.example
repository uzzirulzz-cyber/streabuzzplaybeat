# Copy this file to .env (or set the same vars in Vercel → Project → Settings →
# Environment Variables). Never commit .env — it's in .gitignore on purpose.

# Google AI Studio API key (used by /api/gemini Edge Function).
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional — only needed if the storefront backend (magxtv-proxy worker) starts
# requiring an upstream token. Currently the worker handles auth itself.
# XT_USER=
# XT_PASS=
